# Amazon credentials
AMAZON_EMAIL=deine@email.de
AMAZON_PASSWORD=dein-passwort

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123456789

# Optional: Direkt an eine Slack-App (z.B. Moss) senden
# User-Token (xoxp-...) aus "User Token Scopes" in deiner Slack-App
SLACK_USER_TOKEN=xoxp-...
# Bot-User-ID der Ziel-App (z.B. Moss) – sichtbar in der App-URL in Slack
MOSS_BOT_USER_ID=U0123456789

# Optional: Amazon domain (default: amazon.de)
AMAZON_DOMAIN=amazon.de

# Optional: Wie viele Monate zurück nach Rechnungen suchen (default: 1)
MONTHS_BACK=1
